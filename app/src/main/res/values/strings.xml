    <string name="setup_turn_on">Turn on</string>
    <string name="setup_no_screen">This TV has no settings screen for this. The help under this row gives another way.</string>
    <string name="setup_home">HOME button</string>
    <string name="setup_home_help">Opens KevBox Home when you press HOME and lets the remote’s app buttons open your apps. Turn on “KevBox Home” in the accessibility settings.</string>
    <string name="setup_notifications">Notification access</string>
    <string name="setup_notifications_help">Shows what’s playing in the top bar and, on Fire TV, the recommendations apps post. If the TV has no screen for it: adb shell cmd notification allow_listener tv.kevbox.home/cloud.samlo.couch.MediaListener</string>
    <string name="setup_usage">Usage access</string>
    <string name="setup_usage_help">Screen time in the Index layout and the Recent row. If the TV has no screen for it: adb shell appops set tv.kevbox.home GET_USAGE_STATS allow</string>
    <string name="setup_channels">TV listings</string>
    <string name="setup_channels_help">The preview channels apps publish (YouTube, Jellyfin and others). If the TV has no screen for it: adb shell pm grant tv.kevbox.home android.permission.READ_TV_LISTINGS</string>
